# Copy into a client root (or each stack) after organization apply.
# Replace bucket / table / region from bootstrap outputs.

data "terraform_remote_state" "organization" {
  backend = "s3"
  config = {
    bucket = "REPLACE-tfstate-ACCOUNT"
    key    = "organization/terraform.tfstate"
    region = "eu-north-1"
  }
}

# Example wiring into logging / identity:
#   log_archive_account_id = data.terraform_remote_state.organization.outputs.log_archive_account_id
#   break_glass_allowed_principal_arns = data.terraform_remote_state.identity.outputs.break_glass_allowed_principal_arns
